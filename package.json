{
  "name": "nerva-private",
  "version": "0.3.0",
  "description": "Lenguaje privado con módulos, colecciones, herramientas de proyecto y aprendizaje local",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "nerva": "src/nerva.mjs"
  },
  "exports": {
    ".": "./src/runtime.mjs",
    "./parser": "./src/parser.mjs",
    "./tensor": "./src/tensor.mjs",
    "./project": "./src/project.mjs"
  },
  "files": [
    "src/",
    "examples/",
    "experiments/",
    "docs/",
    "scripts/",
    "provenance.json"
  ],
  "scripts": {
    "nerva": "node src/nerva.mjs",
    "check": "node src/nerva.mjs check",
    "demo": "node src/nerva.mjs run examples/hola.nv",
    "demo:professional": "node src/nerva.mjs run examples/professional --inputs examples/professional/input.json --json",
    "test:professional": "node src/nerva.mjs test examples/professional --json",
    "train:regression": "node src/nerva.mjs run examples/regresion.nv",
    "train:classification": "node src/nerva.mjs run examples/clasificacion.nv",
    "test": "node --test tests/*.test.mjs",
    "explore": "node experiments/run.mjs",
    "verify:origin": "node scripts/verify-origin.mjs"
  }
}
